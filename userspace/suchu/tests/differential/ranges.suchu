// '1..3' and '1 to 3' are one range written two ways. They have to agree in every
// shape a range can take, and 'to' has to stay usable as an ordinary name.

fun show(label, value) {
  print(label @ value);
}

fun main() {
  show("1..4        = ", 1..4);
  show("1 to 4      = ", 1 to 4);
  show("descending  = ", 4 to 1);
  show("negative    = ", -2 to 2);
  show("single      = ", 3 to 3);
  show("equal forms = ", (1..6) == (1 to 6));

  n = 4;
  show("expression  = ", 2 to n + 1);
  show("length      = ", len(1 to 10));

  for i in 1 to 3 {
    print("loop " @ i);
  }
  for (j in 3 to 1) {
    print("down " @ j);
  }

  // Not a keyword: a variable called 'to' still works.
  to = 7;
  show("to as a name = ", to + 1);
}

main();
