import "paint_model.suchu";
import platform; import system; import draw; import chrome; import time;
import "kyil_icons.suchu";
d = paint_model.create(); drawing = false; last_x=0; last_y=0;
buttons=0; pressed_tool=-1; press_at=0; long_done=false;
palette=[16711680,0,3678463]; sizes=[5,11,18]; diameters=[12,20,28];
bench=false; bench_phase=0; bench_frame=0; bench_done=false; installed=false;
shape_count=0; shape_revision=-1; shape_w=0; shape_h=0;
for argument in system.args() { if argument == "--bench" { bench=true; } }
if bench { platform.bench_start("suchu"); }

fun layout(w,h) {
  compact=w<520 || h<330;
  bar_w=if compact then max(1,w-16) else 44;
  bar_h=if compact then 52 else if h>346 then 326 else h-16;
  return [if compact then 8 else 10,h-bar_h-8,bar_w,bar_h,compact];
}
fun tool_bounds(bar,index) {
  if index == 0 { return [bar[0]+(if bar[4] then 8 else 5),bar[1]+(if bar[4] then 8 else 116),34,if bar[4] then 34 else 32]; }
  if index <= 3 {
    i=index-1; return [bar[0]+(if bar[4] then 52+i*42 else 12),bar[1]+(if bar[4] then 11 else 155+i*39),if bar[4] then 28 else 20,if bar[4] then 28 else 20];
  }
  i=index-4; diameter=diameters[i];
  return [bar[0]+(if bar[4] then bar[2]-122+i*40 else paint_model.whole((44-diameter)/2)),bar[1]+(if bar[4] then 26-paint_model.whole(diameter/2) else 273+i*22-paint_model.whole(diameter/2)),diameter,diameter];
}
fun contains(rect,x,y) { return x>=rect[0] && y>=rect[1] && x<rect[0]+rect[2] && y<rect[1]+rect[3]; }
fun hit(bar,x,y) { for i in 0..6 { if contains(tool_bounds(bar,i),x,y) { return i; } } return -1; }
fun select_tool(index) {
  if index == 0 { d.eraser = !d.eraser; }
  if index >= 1 && index <= 3 { d.color=palette[index-1]; d.eraser=false; }
  if index >= 4 { d.radius=sizes[index-4]; d.eraser=false; }
}
fun input(e,w,h,bar) {
  if e[0] == 6 && e[1]%2 == 1 && e[2] == 105 && bench { platform.bench_idle(); }
  if e[0] == 6 && e[1]%2 == 1 && e[2] == 98 && bench && !bench_done && bench_phase == 0 {
    platform.bench_run(); bench_phase=2; bench_frame=0; chrome.invalidate();
  }
  if e[0] == 7 && e[1] == 0 { drawing=false; buttons=0; pressed_tool=-1; }
  if e[0] != 5 { return; }
  x=e[2]; y=e[3]; held=e[1]%2 == 1; was=buttons%2 == 1;
  index=hit(bar,x,y); over_bar=contains(bar,x,y);
  if held && !was {
    pressed_tool=index; press_at=time.now(); long_done=false;
    if !over_bar && x>=0 && y>=0 && x<w && y<h {
      last_x=paint_model.whole(x*640/w); last_y=paint_model.whole(y*360/h); paint_model.stamp(d,last_x,last_y); drawing=true;
    }
  } else if held && drawing {
    if over_bar || x<0 || y<0 || x>=w || y>=h { drawing=false; }
    else { nx=paint_model.whole(x*640/w); ny=paint_model.whole(y*360/h); paint_model.stroke(d,last_x,last_y,nx,ny); last_x=nx; last_y=ny; }
  }
  if !held && was {
    if pressed_tool>=0 && index==pressed_tool { select_tool(index); }
    pressed_tool=-1; drawing=false;
  }
  buttons=e[1];
}
fun draw_tools(bar) {
  // A floating glass palette: hairline frame, generous radius, line icons.
  draw.round_rect(bar[0]-1,bar[1]-1,bar[2]+2,bar[3]+2,15,"field_border");
  draw.round_rect(bar[0],bar[1],bar[2],bar[3],14,"panel");
  if !bar[4] {
    kyil_icons.icon("paint",bar[0]+13,bar[1]+34,18,"accent");
    draw.text(bar[0]+(bar[2]-draw.measure("Paint",10))/2,bar[1]+58,"Paint",10,"faint");
    draw.rect(bar[0]+10,bar[1]+109,bar[2]-20,1,"divider"); draw.rect(bar[0]+10,bar[1]+259,bar[2]-20,1,"divider");
  }
  rect=tool_bounds(bar,0);
  draw.round_rect(rect[0],rect[1],rect[2],rect[3],8,if d.eraser then "accent_soft" else "panel");
  kyil_icons.icon("eraser",rect[0]+(rect[2]-18)/2,rect[1]+(rect[3]-18)/2,18,if d.eraser then "accent" else "muted");
  for i in 1..6 {
    rect=tool_bounds(bar,i); r=rect[2]/2;
    selected=if i<=3 then !d.eraser && d.color==palette[i-1] else d.radius==sizes[i-4];
    color=if i<=3 then palette[i-1] else 14277081;
    cx=rect[0]+r; cy=rect[1]+r;
    if i<=3 {
      // The chosen colour wears an accent ring.
      if selected { draw.circle(cx,cy,r+2,"accent"); draw.circle(cx,cy,r,"panel"); }
      draw.circle(cx,cy,if selected then max(1,r-2) else r,color);
    } else {
      // Brush sizes: three dots of growing size on a shared rhythm, the
      // chosen one on a soft pill (the hit areas stay the larger circles).
      dot=[3,5,7][i-4];
      if selected { draw.round_rect(cx-(if bar[4] then 14 else bar[2]/2-6),cy-9,if bar[4] then 28 else bar[2]-12,18,9,"accent_soft"); }
      draw.circle(cx,cy,dot,if selected then "accent" else "muted");
    }
  }
}
// The document remains authoritative for resize/clear. Ordinary updates append
// only new stamps to the retained canvas; the toolbar is never baked into it.
fun draw_document(w,h) {
  restored=draw.cache_restore("document");
  rebuild=!restored || w!=shape_w || h!=shape_h || shape_revision!=d.revision || shape_count>len(d.stamps);
  if rebuild {
    draw.clear(14277081); shape_count=0;
  }
  shapes=[];
  if shape_count<len(d.stamps) {
    for i in shape_count..(len(d.stamps)-1) {
      s=d.stamps[i]; r=max(1,paint_model.whole(s[2]*w/640));
      push(shapes,paint_model.whole(s[0]*w/640)+0.5);
      push(shapes,paint_model.whole(s[1]*h/360)+0.5);
      push(shapes,r+0.5); push(shapes,s[3]);
    }
  }
  draw.circles(shapes);
  if rebuild || shape_count<len(d.stamps) {
    if draw.cache_save("document") {
      shape_count=len(d.stamps); shape_revision=d.revision; shape_w=w; shape_h=h;
    } else {
      // Real allocation/clipping failure: next frame redraws the full document.
      shape_count=0; shape_revision=-1;
    }
  }
}
fun paint() {
  if !installed { platform.install(false); installed=true; }
  w=draw.width(); h=draw.height(); bar=layout(w,h);
  for e in platform.events() { input(e,w,h,bar); }
  if pressed_tool == 0 && buttons%2 == 1 && !long_done {
    if time.now()-press_at >= 0.4 { paint_model.clear(d); long_done=true; }
    else { platform.wake_after(max(1,round(ceil((0.4-(time.now()-press_at))*1000)))); }
  }
  if bench_phase>=2 && bench_phase<=5 {
    platform.bench_tag(bench_phase); paint_model.replay(d,bench_phase,bench_frame);
    bench_frame=bench_frame+1;
    if bench_frame==16 { bench_frame=0; bench_phase=bench_phase+1; }
    chrome.invalidate();
  } else if bench_phase == 6 {
    platform.bench_report(len(d.stamps),paint_model.checksum(d)); bench_done=true; bench_phase=0;
  }
  draw_document(w,h);
  draw_tools(bar);
}
Window("KyIl Paint",1200px,720px) {
  min-width: 320px; min-height: 220px; padding: 0px; spacing: 0px; exit-key: "none"; max-fps: 0;
  Canvas { width: fill; height: fill; onDraw: { paint(); }; }
}
