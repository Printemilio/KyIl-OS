import "editor_model.suchu";
import textbytes;
import files;
passed = 0;
fun check(test, name) { if !test { textbytes.fail("FAILED: " @ name); } passed = passed + 1; }
d = editor_model.create("", "αé\r\nsecond\nlast");
check(d.state[2] == 3, "mixed newline inventory");
check(d.eol == "\r\n", "preferred CRLF");
check(editor_model.next(d, 0) == 2, "UTF-8 next");
check(editor_model.previous(d, 4) == 2, "UTF-8 previous");
check(editor_model.next(d, 4) == 6, "CRLF atom");
check(editor_model.line_start(d, 1) == 6, "line index");
check(editor_model.column(d, 6) == 0, "column after CRLF");
check(editor_model.offset_at(d, 1, 3) == 9, "visual position after slice calls");
check(editor_model.clipped_start(d, 1, 3)[1] == 9, "viewport clipping offset");
rejected = false;
try { editor_model.replace(d, 1, 0, "x", true); } else error { rejected = true; }
check(rejected && editor_model.slice(d, 0, 4) == "αé", "reject split UTF-8 without mutation");
rejected = false;
try { editor_model.replace(d, 5, 0, "x", true); } else error { rejected = true; }
check(rejected, "reject split CRLF");
d.state[3] = 2; d.state[4] = 4; editor_model.insert_text(d, "漢");
check(editor_model.slice(d, 0, d.state[1]) == "α漢\r\nsecond\nlast", "replace UTF-8 range");
editor_model.undo(d); check(editor_model.slice(d, 0, d.state[1]) == "αé\r\nsecond\nlast", "undo exact bytes");
check(!editor_model.dirty(d), "undo reaches saved revision");
editor_model.redo(d); check(editor_model.dirty(d), "redo revision");
check(editor_model.find(d, "漢\r\nsec", 0) == 2, "find across pieces");
d.state[3] = d.state[1]; d.state[4] = d.state[3]; editor_model.insert_text(d, "\t!");
path = "/home/root/editor regression UTF8 é.txt";
editor_model.save(d, path); check(!editor_model.dirty(d), "published save");
reopened = editor_model.read(path); check(editor_model.slice(reopened, 0, reopened.state[1]) == editor_model.slice(d, 0, d.state[1]), "exact readback UTF-8 spaced path");
editor_model.insert_text(d, "changed");
failed = false;
try { editor_model.save(d, "/usr/native-tests/suchu_editor_test"); } else error { failed = true; }
check(failed && editor_model.dirty(d), "failed save preserves dirty state");
check(editor_model.read(path).state[1] == reopened.state[1], "failed save retains original");
empty = editor_model.create("", ""); editor_model.save(empty, "/home/root/editor empty.txt");
check(editor_model.read("/home/root/editor empty.txt").state[1] == 0, "empty persisted");
parts = []; for i in 1..40000 { push(parts, "line\n"); }
large = editor_model.create("", "".join(parts));
check(large.state[2] == 40001, "large line inventory");
large.state[3] = 50000; large.state[4] = large.state[3];
for i in 1..500 { editor_model.insert_text(large, "é"); }
check(len(large.state[0]) <= 4, "sequential typing merges pieces");
check(large.state[1] == 201000, "large edits byte count");
check(editor_model.line_start(large, 40000) == 201000, "line index after edit");
editor_model.save(large, "/home/root/editor large.txt");
check(editor_model.read("/home/root/editor large.txt").state[1] == 201000, "large save readback");
r = editor_model.create("", ""); oracle = ""; seed = 71;
for turn in 1..200 {
  offsets = [0]; at = 0; while at < len(oracle) { at = textbytes.next(oracle, at); push(offsets, at); }
  seed = (seed * 1664525 + 1013904223) % 2147483647;
  index = seed % len(offsets); at = offsets[index]; end = offsets[min(len(offsets) - 1, index + seed % 4)];
  insert = if turn % 3 == 0 then "é\t\n" else if turn % 3 == 1 then "abc" else "λ";
  before = oracle; revision = r.state[5]; editor_model.replace(r, at, end - at, insert, true);
  oracle = textbytes.sub(oracle, 0, at) @ insert @ textbytes.sub(oracle, end, len(oracle) - end);
  check(editor_model.slice(r, 0, r.state[1]) == oracle, "independent byte-string oracle");
  check(r.state[2] == len(oracle.split("\n")), "independent line oracle");
  for row in 0..(r.state[2] - 1) { pos = editor_model.line_start(r, row); check(editor_model.line_at(r, pos) == row, "line index roundtrip"); }
  if before == oracle { check(r.state[5] == revision, "no-op keeps history revision"); }
  if turn % 7 == 0 && before != oracle {
    editor_model.undo(r); check(editor_model.slice(r, 0, r.state[1]) == before, "random undo");
    editor_model.redo(r); check(editor_model.slice(r, 0, r.state[1]) == oracle, "random redo");
  }
}
print("Suchu editor model: PASS ", passed, " checks");
