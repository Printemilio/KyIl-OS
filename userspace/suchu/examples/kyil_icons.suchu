// The KyIlOS icon family, for applications. Line art on an 18-unit grid,
// 1.6-unit strokes with round ends -- the same drawings as the desktop menu
// (scripts/generate_kyil_ui_assets.py). Every icon is draw(name, x, y, size,
// ink): (x, y) the top-left corner, size in pixels, ink a theme token.
import draw;

fun seg(x1, y1, x2, y2, w, ink) {
  draw.line(x1, y1, x2, y2, w, ink);
  draw.circle(x1, y1, w / 2, ink); draw.circle(x2, y2, w / 2, ink);
}
// A polyline: [x0, y0, x1, y1, ...] in grid units.
fun path(x, y, k, points, w, ink) {
  i = 0;
  while i + 3 < len(points) {
    seg(x + points[i] * k, y + points[i + 1] * k, x + points[i + 2] * k, y + points[i + 3] * k, w, ink);
    i = i + 2;
  }
}
fun arc(cx, cy, r, from, to, w, ink) {
  steps = max(6, round(floor(abs(to - from) / 20))); i = 0;
  while i < steps {
    a = (from + (to - from) * i / steps) * 3.14159265 / 180;
    b = (from + (to - from) * (i + 1) / steps) * 3.14159265 / 180;
    seg(cx + cos(a) * r, cy + sin(a) * r, cx + cos(b) * r, cy + sin(b) * r, w, ink);
    i = i + 1;
  }
}
fun frame(x, y, w, h, r, sw, ink) {
  seg(x + r, y, x + w - r, y, sw, ink); seg(x + r, y + h, x + w - r, y + h, sw, ink);
  seg(x, y + r, x, y + h - r, sw, ink); seg(x + w, y + r, x + w, y + h - r, sw, ink);
  arc(x + r, y + r, r, 180, 270, sw, ink); arc(x + w - r, y + r, r, 270, 360, sw, ink);
  arc(x + w - r, y + h - r, r, 0, 90, sw, ink); arc(x + r, y + h - r, r, 90, 180, sw, ink);
}
fun icon(name, x, y, size, ink) {
  k = size / 18; w = max(1.2, 1.6 * k);
  if name == "back" { path(x, y, k, [11, 4, 6, 9, 11, 14], w, ink); }
  else if name == "forward" { path(x, y, k, [7, 4, 12, 9, 7, 14], w, ink); }
  else if name == "up" { path(x, y, k, [4, 11, 9, 6, 14, 11], w, ink); }
  else if name == "plus" { path(x, y, k, [9, 3.5, 9, 14.5], w, ink); path(x, y, k, [3.5, 9, 14.5, 9], w, ink); }
  else if name == "close" { path(x, y, k, [5, 5, 13, 13], w, ink); path(x, y, k, [13, 5, 5, 13], w, ink); }
  else if name == "folder" { path(x, y, k, [2, 5, 2, 14, 16, 14, 16, 6.6, 9.2, 6.6, 7.6, 4.2, 2, 4.2, 2, 5], w, ink); }
  else if name == "new_folder" {
    path(x, y, k, [2, 5, 2, 14, 9.5, 14], w, ink); path(x, y, k, [16, 9.5, 16, 6.6, 9.2, 6.6, 7.6, 4.2, 2, 4.2, 2, 5], w, ink);
    path(x, y, k, [14, 11.2, 14, 16.4], w, ink); path(x, y, k, [11.4, 13.8, 16.6, 13.8], w, ink);
  }
  else if name == "file" {
    path(x, y, k, [10.5, 2.2, 4, 2.2, 4, 15.8, 14, 15.8, 14, 5.7, 10.5, 2.2, 10.5, 5.7, 14, 5.7], w, ink);
  }
  else if name == "document" {
    icon("file", x, y, size, ink);
    path(x, y, k, [6.8, 9.4, 11.2, 9.4], w, ink); path(x, y, k, [6.8, 12.4, 11.2, 12.4], w, ink);
  }
  else if name == "copy" {
    frame(x + 6 * k, y + 6 * k, 9.5 * k, 9.5 * k, 2 * k, w, ink);
    path(x, y, k, [3, 11.5, 3, 4.5, 4.5, 3, 11.5, 3], w, ink);
  }
  else if name == "paste" {
    frame(x + 3.5 * k, y + 3.5 * k, 11 * k, 12.5 * k, 2 * k, w, ink);
    path(x, y, k, [7, 2.5, 11, 2.5], w + 0.6, ink); path(x, y, k, [6.5, 9, 11.5, 9], w, ink); path(x, y, k, [6.5, 12, 10, 12], w, ink);
  }
  else if name == "cut" {
    arc(x + 5 * k, y + 13 * k, 2.4 * k, 0, 360, w, ink); arc(x + 13 * k, y + 13 * k, 2.4 * k, 0, 360, w, ink);
    path(x, y, k, [6.8, 11.2, 13.5, 2.5], w, ink); path(x, y, k, [11.2, 11.2, 4.5, 2.5], w, ink);
  }
  else if name == "trash" {
    path(x, y, k, [3, 5, 15, 5], w, ink); path(x, y, k, [7, 5, 7.6, 2.8, 10.4, 2.8, 11, 5], w, ink);
    path(x, y, k, [4.6, 5, 5.6, 15.4, 12.4, 15.4, 13.4, 5], w, ink);
  }
  else if name == "info" {
    arc(x + 9 * k, y + 9 * k, 7 * k, 0, 360, w, ink);
    path(x, y, k, [9, 8.2, 9, 12.6], w, ink); draw.circle(x + 9 * k, y + 5.6 * k, w * 0.6, ink);
  }
  else if name == "rename" {
    path(x, y, k, [12.5, 2.8, 15.2, 5.5, 7.2, 13.5, 4, 14, 4.5, 10.8, 12.5, 2.8], w, ink);
  }
  else if name == "open" {
    frame(x + 2.5 * k, y + 3.5 * k, 13 * k, 12 * k, 2 * k, w, ink);
    path(x, y, k, [8, 10, 13.5, 4.5], w, ink); path(x, y, k, [9.5, 4.5, 13.5, 4.5, 13.5, 8.5], w, ink);
  }
  else if name == "grid" {
    frame(x + 2.5 * k, y + 2.5 * k, 5 * k, 5 * k, 1.2 * k, w, ink); frame(x + 10.5 * k, y + 2.5 * k, 5 * k, 5 * k, 1.2 * k, w, ink);
    frame(x + 2.5 * k, y + 10.5 * k, 5 * k, 5 * k, 1.2 * k, w, ink); frame(x + 10.5 * k, y + 10.5 * k, 5 * k, 5 * k, 1.2 * k, w, ink);
  }
  else if name == "list" {
    path(x, y, k, [6.5, 4.5, 15.5, 4.5], w, ink); path(x, y, k, [6.5, 9, 15.5, 9], w, ink); path(x, y, k, [6.5, 13.5, 15.5, 13.5], w, ink);
    draw.circle(x + 3 * k, y + 4.5 * k, w * 0.7, ink); draw.circle(x + 3 * k, y + 9 * k, w * 0.7, ink); draw.circle(x + 3 * k, y + 13.5 * k, w * 0.7, ink);
  }
  else if name == "search" {
    arc(x + 7.8 * k, y + 7.8 * k, 5 * k, 0, 360, w, ink); path(x, y, k, [11.6, 11.6, 15.4, 15.4], w, ink);
  }
  else if name == "reload" {
    arc(x + 9 * k, y + 9 * k, 6.2 * k, 20, 320, w, ink); path(x, y, k, [15.4, 2.6, 15.4, 6.6, 11.4, 6.6], w, ink);
  }
  else if name == "stop" { icon("close", x, y, size, ink); }
  else if name == "download" {
    path(x, y, k, [9, 2.5, 9, 11.5], w, ink); path(x, y, k, [5, 7.8, 9, 11.8, 13, 7.8], w, ink);
    path(x, y, k, [3, 12.5, 3, 15.4, 15, 15.4, 15, 12.5], w, ink);
  }
  else if name == "save" {
    frame(x + 2.5 * k, y + 2.5 * k, 13 * k, 13 * k, 2.2 * k, w, ink);
    path(x, y, k, [6, 2.8, 6, 6.6, 12, 6.6, 12, 2.8], w, ink); path(x, y, k, [6, 15.2, 6, 11, 12, 11, 12, 15.2], w, ink);
  }
  else if name == "undo" { arc(x + 9.5 * k, y + 10 * k, 5.5 * k, 200, 400, w, ink); path(x, y, k, [3.2, 4.4, 3.8, 8.6, 8, 8], w, ink); }
  else if name == "redo" { arc(x + 8.5 * k, y + 10 * k, 5.5 * k, 140, 340, w, ink); path(x, y, k, [14.8, 4.4, 14.2, 8.6, 10, 8], w, ink); }
  else if name == "more" {
    draw.circle(x + 4 * k, y + 9 * k, 1.3 * k, ink); draw.circle(x + 9 * k, y + 9 * k, 1.3 * k, ink); draw.circle(x + 14 * k, y + 9 * k, 1.3 * k, ink);
  }
  else if name == "home" {
    path(x, y, k, [2.5, 8.6, 9, 3, 15.5, 8.6], w, ink); path(x, y, k, [4.5, 7.4, 4.5, 15, 13.5, 15, 13.5, 7.4], w, ink);
    path(x, y, k, [7.6, 15, 7.6, 11, 10.4, 11, 10.4, 15], w, ink);
  }
  else if name == "desktop" {
    frame(x + 2 * k, y + 3 * k, 14 * k, 9.5 * k, 1.8 * k, w, ink); path(x, y, k, [9, 12.5, 9, 15], w, ink); path(x, y, k, [5.8, 15.2, 12.2, 15.2], w, ink);
  }
  else if name == "disk" {
    frame(x + 2 * k, y + 5 * k, 14 * k, 8 * k, 2 * k, w, ink); draw.circle(x + 12.6 * k, y + 9 * k, 1.1 * k, ink);
  }
  else if name == "clock" {
    arc(x + 9 * k, y + 9 * k, 7 * k, 0, 360, w, ink); path(x, y, k, [9, 5, 9, 9, 12, 10.8], w, ink);
  }
  else if name == "terminal" {
    frame(x + 1.8 * k, y + 3 * k, 14.4 * k, 12 * k, 3 * k, w, ink);
    path(x, y, k, [5.2, 7, 7.6, 9, 5.2, 11], w, ink); path(x, y, k, [9.4, 11.2, 12.6, 11.2], w, ink);
  }
  else if name == "browser" {
    arc(x + 9 * k, y + 9 * k, 7 * k, 0, 360, w, ink); path(x, y, k, [2.6, 9, 15.4, 9], w, ink);
    arc(x + 15.5 * k, y + 9 * k, 8.6 * k, 145, 215, w, ink); arc(x + 2.5 * k, y + 9 * k, 8.6 * k, -35, 35, w, ink);
  }
  else if name == "paint" {
    path(x, y, k, [12.5, 2.8, 15.2, 5.5, 8.2, 12.5, 5.5, 9.8, 12.5, 2.8], w, ink); path(x, y, k, [5.5, 12.5, 3, 15], w + 0.6, ink);
  }
  else if name == "eraser" {
    path(x, y, k, [10.8, 2.8, 15.6, 7.6, 8.6, 14.6, 5.4, 14.6, 2.4, 11.6, 10.8, 2.8], w, ink);
    path(x, y, k, [6.8, 6.8, 11.6, 11.6], w, ink); path(x, y, k, [8.6, 14.6, 15.6, 14.6], w, ink);
  }
  else if name == "lock" {
    frame(x + 3.5 * k, y + 8 * k, 11 * k, 7.5 * k, 1.8 * k, w, ink); arc(x + 9 * k, y + 8 * k, 3.2 * k, 180, 360, w, ink);
  }
  else if name == "numbers" { path(x, y, k, [7, 3, 5.5, 15], w, ink); path(x, y, k, [12.5, 3, 11, 15], w, ink); path(x, y, k, [3.5, 6.5, 15, 6.5], w, ink); path(x, y, k, [3, 11.5, 14.5, 11.5], w, ink); }
}
// A rounded hover/press plate behind an icon button.
fun plate(x, y, w, h, hovered, pressed) {
  if pressed { draw.round_rect(x, y, w, h, 7, "accent_soft"); }
  else if hovered { draw.round_rect(x, y, w, h, 7, "hover"); }
}
