import "files_model.suchu";
import files; import fileio; import platform; import system; import draw; import chrome;
import textbytes;
cwd="/home/root"; entries=[]; selected=-1; top=0; back=[]; forward=[];
clipboard=""; cut=false; notice=""; failed=false; info=false; modal="";
last_buttons=0; last_click=-1; last_at=0; prefix=""; prefix_at=0;
ready=false; row_height=30; visible_rows=10; signature="";
fun say(message,error) { notice=(if error then "Error: " else "") @ message; failed=error; }
fun selection() { if selected>=0 && selected<len(entries) { return entries[selected]; } return none; }
fun fingerprint(values) {
  parts=[]; for item in values { push(parts,item.name @ ":" @ item.kind @ ":" @ item.size @ ":" @ item.mode); } return "\n".join(parts);
}
fun reload(keep) {
  fresh=files_model.list(cwd); sig=fingerprint(fresh);
  if sig==signature && keep=="" { return; }
  if keep=="" && selection()!=none { keep=selection().name; }
  entries=fresh; signature=sig; selected=-1;
  if keep!="" && len(entries)>0 { for i in 0..(len(entries)-1) { if entries[i].name==keep { selected=i; } } }
  top=max(0,min(top,len(entries)-visible_rows)); chrome.invalidate();
}
fun history(stack,path) { push(stack,path); if len(stack)>16 { remove(stack,0); } }
fun navigate(path,record) {
  target=files_model.resolve(cwd,path); fresh=files_model.list(target);
  if record && cwd!=target { history(back,cwd); forward=[]; }
  cwd=target; entries=fresh; signature=fingerprint(fresh); selected=-1; top=0;
  set_text(location,cwd); say(cwd,false); blur(); chrome.invalidate();
}
fun go_back() {
  if len(back)==0 { return; } target=back[len(back)-1];
  try { old=cwd; navigate(target,false); back.pop(); history(forward,old); } else error { say(error.message,true); }
}
fun go_forward() {
  if len(forward)==0 { return; } target=forward[len(forward)-1];
  try { old=cwd; navigate(target,false); forward.pop(); history(back,old); } else error { say(error.message,true); }
}
fun place(path) {
  try {
    if path=="/home/root/Downloads" && !fileio.exists(path) { fileio.mkdir(path,493); }
    navigate(path,true);
  } else error { say(error.message,true); }
}
fun open_selected() {
  item=selection(); if item==none { return; }
  try {
    if item.kind=="directory" { navigate(item.path,true); return; }
    if files_model.transient(item.name) { say("This file is still downloading",false); return; }
    if files_model.executable(item.mode) && item.kind=="file" {
      pid=platform.spawn(item.path); push(children,pid); say("Started PID " @ pid,false);
    } else {
      if files_model.binary(item.path) { say("Binary file: no text viewer registered",true); return; }
      platform.open_path(item.path,0); say("Open request submitted",false);
    }
  } else error { say(error.message,true); }
}
children=[];
fun collect_children() {
  i=0; while i<len(children) {
    result=platform.wait_child(children[i]);
    if result[0]!=0 { remove(children,i); } else { i=i+1; }
  }
}
fun remember(move) { item=selection(); if item!=none { clipboard=item.path; cut=move; say((if cut then "Cut: " else "Copy: ") @ clipboard,false); } }
fun paste() {
  if clipboard=="" { return; }
  try {
    target=if cut then files_model.move(clipboard,cwd) else files_model.copy(clipboard,cwd);
    if cut { clipboard=""; }
    reload(files_model.basename(target)); say("Completed: " @ target,false);
  } else error { say(error.message,true); }
}
fun ask(kind) {
  if kind!="new" && selection()==none { return; }
  modal=kind; set_visible(dialog,true); set_visible(dialog_path,kind!="delete");
  set_text(dialog_message,if kind=="new" then "New folder" else if kind=="rename" then "Rename " @ selection().name else "Delete " @ selection().name @ " and all its contents? This cannot be undone.");
  set_text(dialog_path,if kind=="rename" then selection().name else "");
  if kind!="delete" { focus(dialog_path); } else { blur(); }
}
fun cancel() { modal=""; set_visible(dialog,false); blur(); }
fun confirm() {
  try {
    if modal=="new" { path=files_model.create(cwd,get_text(dialog_path)); reload(files_model.basename(path)); }
    if modal=="rename" { path=files_model.rename(selection().path,get_text(dialog_path)); reload(files_model.basename(path)); }
    if modal=="delete" { files_model.erase(selection().path); reload(""); }
    say("Completed",false); cancel();
  } else error { say(error.message,true); }
}
fun ensure_visible() {
  if selected>=0 { if selected<top { top=selected; } if selected>=top+visible_rows { top=selected-visible_rows+1; } }
}
fun key(key,hardware,ctrl,alt) {
  if key==27 { cancel(); return; }
  if modal!="" { if key==10 { confirm(); } return; }
  if is_focused(location) { if key==10 { try { navigate(get_text(location),true); } else error { say(error.message,true); } } return; }
  if ctrl && (key==3 || key==99 || key==67) { remember(false); return; }
  if ctrl && (key==24 || key==120 || key==88) { remember(true); return; }
  if ctrl && (key==22 || key==118 || key==86) { paste(); return; }
  if ctrl && (key==108 || key==76 || key==12) { focus(location); return; }
  if hardware==63 { try { reload(""); } else error { say(error.message,true); } return; }
  if hardware==60 { ask("rename"); return; }
  if hardware==211 { ask("delete"); return; }
  if hardware==203 { go_back(); return; } if hardware==205 { go_forward(); return; }
  if key==8 { place(files_model.parent(cwd)); return; }
  if key==10 { open_selected(); return; }
  if len(entries)==0 { return; }
  if hardware==200 { selected=max(0,selected-1); ensure_visible(); return; }
  if hardware==208 { selected=min(len(entries)-1,selected+1); ensure_visible(); return; }
  if hardware==201 { selected=max(0,selected-visible_rows); ensure_visible(); return; }
  if hardware==209 { selected=min(len(entries)-1,selected+visible_rows); ensure_visible(); return; }
  if hardware==199 { selected=0; ensure_visible(); return; } if hardware==207 { selected=len(entries)-1; ensure_visible(); return; }
  if !ctrl && !alt && key>=32 && key<1114112 {
    now=platform.monotonic(); if now-prefix_at>1 { prefix=""; } prefix_at=now;
    prefix=prefix @ textbytes.character(key).lower();
    for i in 0..(len(entries)-1) { if entries[i].name.lower().startswith(prefix) { selected=i; ensure_visible(); return; } }
  }
}
fun events(bounds) {
  for e in platform.events() {
    if e[0]==6 && e[1]%2==1 {
      mods=files_model.whole(e[1]/256)%256;
      key(e[2],e[3],mods%2==1,files_model.whole(mods/4)%2==1);
    }
    if e[0]==7 && e[1]==0 { last_buttons=0; }
    if e[0]==5 {
      x=e[2]-bounds[0]; y=e[3]-bounds[1]; inside=x>=0 && y>=0 && x<bounds[2] && y<bounds[3];
      held=e[1]%2==1;
      if inside && modal=="" {
        if e[4]!=0 { top=max(0,min(max(0,len(entries)-visible_rows),top-e[4]*3)); }
        if held && last_buttons%2==0 && y>=32 {
          at=top+files_model.whole((y-32)/row_height);
          if at>=0 && at<len(entries) {
            now=platform.monotonic(); selected=at; blur();
            if at==last_click && now-last_at<0.45 { last_click=-1; open_selected(); }
            else { last_click=at; last_at=now; }
          }
        }
      }
      last_buttons=e[1];
    }
  }
}
fun initialize() {
  context=platform.context(1); args=system.args(); if len(args)>0 { context=args[0]; }
  if context!="" { cwd=files_model.resolve("/",context); }
  try { navigate(cwd,false); } else error { cwd="/"; navigate(cwd,false); say(error.message,true); }
  ready=true;
}
fun draw_listing() {
  if !ready { initialize(); }
  b=get_bounds(listing); visible_rows=max(1,files_model.whole((b[3]-32)/row_height)); events(b);
  w=draw.width(); h=draw.height(); draw.clear(1184276);
  draw.rect(0,0,w,30,2105380); draw.text(16,7,"Name",14,15658734);
  if w>540 { draw.text(w-280,7,"Kind",14,15658734); draw.text(w-150,7,"Size",14,15658734); }
  stop=min(len(entries),top+visible_rows);
  if stop>top { for i in top..(stop-1) {
    item=entries[i]; y=32+(i-top)*row_height;
    if i==selected { draw.round_rect(4,y,w-14,row_height-2,4,3880796); }
    draw.rect(13,y+9,13,11,if item.kind=="directory" then 14332988 else if item.kind=="link" then 8562175 else 12434877);
    label=item.name; available=max(1,files_model.whole((w-(if w>540 then 340 else 55))/8));
    if len(label)>available { label=textbytes.sub(label,0,available) @ "…"; }
    draw.text(37,y+7,label,14,if files_model.transient(item.name) then 11053224 else 15658734);
    if w>540 { draw.text(w-280,y+7,item.kind,12,11710926); draw.text(w-150,y+7,files_model.size_text(item.size),12,11710926); }
  } }
  if len(entries)>visible_rows { draw.rect(w-7,32+(h-32)*top/len(entries),4,max(12,(h-32)*visible_rows/len(entries)),6381921); }
  set_enabled(back_button,len(back)>0); set_enabled(forward_button,len(forward)>0);
  for node in [open_button,rename_button,copy_button,cut_button,delete_button] { set_enabled(node,selection()!=none && modal==""); }
  set_enabled(paste_button,clipboard!="" && modal=="");
  text="" @ len(entries) @ " items"; if selection()!=none { text=text @ " · " @ selection().name; }
  set_text(summary,text @ "   " @ notice);
  if info && selection()!=none {
    item=selection(); set_text(properties,item.path @ "\n" @ item.kind @ " · " @ files_model.size_text(item.size) @ " · " @ files_model.mode_text(item.mode) @ " · uid " @ item.uid @ " / gid " @ item.gid);
  } else { set_text(properties,"Select an item to inspect its real metadata."); }
}
platform.install(false);
Window("KyIl Files",900px,580px) {
  min-width: 450px; min-height: 320px; background: #121214; layout: column; padding: 0px; spacing: 0px; exit-key: "none"; max-fps: 0;
  Row { width: fill; height: 42px; padding: 6px; spacing: 5px; background: #202024;
    Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; id: "back_button"; text: "‹"; width: 28px; height: 28px; onClick: { go_back(); }; }
    Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; id: "forward_button"; text: "›"; width: 28px; height: 28px; onClick: { go_forward(); }; }
    Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; text: "Up"; height: 28px; onClick: { place(files_model.parent(cwd)); }; }
    Input { id: "location"; width: fill; height: 28px; background: #121214; color: #eeeeee; }
    Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; text: "Go"; height: 28px; onClick: { try { navigate(get_text(location),true); } else error { say(error.message,true); } }; }
    Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; text: "Refresh"; height: 28px; onClick: { try { reload(""); say("Refreshed",false); } else error { say(error.message,true); } }; }
  }
  Row { width: fill; height: 40px; padding: 5px; spacing: 5px; background: #202024;
    Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; text: "New folder"; height: 28px; onClick: { ask("new"); }; }
    Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; id: "open_button"; text: "Open"; height: 28px; onClick: { open_selected(); }; }
    Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; id: "rename_button"; text: "Rename"; height: 28px; onClick: { ask("rename"); }; }
    Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; id: "copy_button"; text: "Copy"; height: 28px; onClick: { remember(false); }; }
    Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; id: "cut_button"; text: "Cut"; height: 28px; onClick: { remember(true); }; }
  }
  Row { width: fill; height: 38px; padding: 5px; spacing: 5px; background: #202024;
    Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; id: "paste_button"; text: "Paste"; height: 28px; onClick: { paste(); }; }
    Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; id: "delete_button"; text: "Delete"; height: 28px; onClick: { ask("delete"); }; }
    Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; text: "Properties"; height: 28px; onClick: { info=!info; set_visible(info_panel,info); }; }
  }
  Row { width: fill; height: fill; spacing: 0px;
    Column { width: 130px; height: fill; padding: 8px; spacing: 7px; background: #1b1920;
      Label { text: "Places"; color: #bdb3ce; font-size: 13px; }
      Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; text: "Home"; width: fill; onClick: { place("/home/root"); }; }
      Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; text: "Desktop"; width: fill; onClick: { place("/home/root/Desktop"); }; }
      Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; text: "Downloads"; width: fill; onClick: { place("/home/root/Downloads"); }; }
      Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; text: "Filesystem"; width: fill; onClick: { place("/"); }; }
      Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; text: "Temporary"; width: fill; onClick: { place("/tmp"); }; }
    }
    Canvas { id: "listing"; width: fill; height: fill; onDraw: { draw_listing(); }; }
  }
  Column { id: "info_panel"; width: fill; height: 96px; padding: 7px; visible: false; background: #202024;
    Label { id: "properties"; width: fill; height: 42px; text: ""; color: #eeeeee; font-size: 13px; }
    Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; text: "Toggle executable"; height: 28px; onClick: { if selection()!=none { try { files_model.toggle_executable(selection().path); reload(""); } else error { say(error.message,true); } } }; }
  }
  Column { id: "dialog"; width: fill; height: 136px; padding: 7px; spacing: 5px; visible: false; background: #30243b;
    Label { id: "dialog_message"; text: ""; color: #eeeeee; }
    Input { id: "dialog_path"; width: fill; height: 28px; color: #eeeeee; background: #121214; }
    Row { spacing: 8px;
      Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; text: "Confirm"; height: 26px; onClick: { confirm(); }; }
      Button { background: #30243b; color: #eeeeee; font-size: 14px; border-radius: 4px; padding: 6px; text: "Cancel"; height: 26px; onClick: { cancel(); }; }
    }
  }
  Label { id: "summary"; width: fill; height: 28px; padding: 5px; font-size: 12px; text: "Starting…"; color: #bdb3ce; background: #202024; }
  Timer { interval: 1000ms; onTick: {
    if ready { try { reload(""); collect_children(); } else error { say(error.message,true); } }
  }; }
}
