// Application selection/lifecycle in Suchu; native spawn/wait are OS bridges.
// Shown as a small Launchpad: one rounded tile per application.
import platform; import draw; import chrome;
import "kyil_icons.suchu";
items=[["Terminal","/usr/bin/kyil-terminal",255,"terminal"],["Files","/usr/bin/kyil-files",0,"folder"],
       ["Editor","/usr/bin/kyil-editor",0,"document"],["Paint","/usr/bin/kyil-paint",0,"paint"],
       ["Browser","/usr/bin/kyil-browser",128,"browser"]];
children=[]; last_buttons=0; message="Choose an application"; hover=-1; pressed=-1;
tile=88; gap=18;
fun launch(index) {
  try { pid=platform.spawn_caps(items[index][1],items[index][2]); push(children,[pid,items[index][0]]); message=items[index][0] @ " is starting…"; }
  else error { message=error.message; }
}
fun collect() {
  i=0; while i<len(children) {
    try {
      status=platform.wait_child(children[i][0]);
      if status[0]!=0 { message=children[i][1] @ " closed"; remove(children,i); }
      else { i=i+1; }
    } else error { message=error.message; i=i+1; }
  }
}
fun layout(w) { per=max(1,round(floor((w-gap)/(tile+gap)))); return [per,(w-(per*(tile+gap)-gap))/2]; }
fun index_at(x,y,w) {
  l=layout(w); per=l[0]; left=l[1];
  col=round(floor((x-left)/(tile+gap))); row=round(floor((y-24)/(tile+44)));
  if x<left || col>=per || y<24 { return -1; }
  if x-left-col*(tile+gap)>tile || y-24-row*(tile+44)>tile+30 { return -1; }
  at=row*per+col; return if at<len(items) then at else -1;
}
fun paint() {
  b=get_bounds(tiles); w=draw.width(); h=draw.height();
  for e in platform.events() {
    if e[0]==7 && e[1]==0 { last_buttons=0; pressed=-1; }
    if e[0]==5 {
      held=e[1]%2==1; x=e[2]-b[0]; y=e[3]-b[1]; hover=index_at(x,y,w);
      if held && last_buttons%2==0 { pressed=hover; }
      if !held && last_buttons%2==1 { if pressed>=0 && pressed==hover { launch(pressed); } pressed=-1; }
      last_buttons=e[1];
    }
  }
  draw.clear("window");
  l=layout(w); per=l[0]; left=l[1];
  for i in 0..(len(items)-1) {
    col=i%per; row=round(floor(i/per)); x=left+col*(tile+gap); y=24+row*(tile+44);
    lift=if i==pressed then 2 else 0;
    if i==hover { draw.round_rect(x-6,y-6,tile+12,tile+38,18,"hover"); }
    draw.round_rect(x+lift,y+lift,tile-2*lift,tile-2*lift,22,"accent_soft");
    kyil_icons.icon(items[i][3],x+tile/2-18,y+tile/2-18,36,"accent");
    nw=draw.measure(items[i][0],13);
    draw.text(x+(tile-nw)/2,y+tile+8,items[i][0],13,"text");
  }
  draw.text((w-draw.measure(message,12))/2,h-26,message,12,"faint");
}
platform.install(false);
Window("KyIl Applications",560px,360px) {
  min-width: 300px; min-height: 300px; padding: 0px; spacing: 0px; layout: column; background: window; color: text; exit-key: "none";
  Canvas { id: "tiles"; width: fill; height: fill; onDraw: { paint(); }; }
  Timer { interval: 1000ms; onTick: { if len(children)>0 { collect(); } }; }
}
