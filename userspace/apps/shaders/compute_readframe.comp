#version 450
layout(local_size_x=8) in;
layout(set=0,binding=0,rgba8) readonly uniform image2D sourceImage;
layout(set=0,binding=1,std430) buffer Result{uint pixels[];} result;
void main(){
    uint x=gl_GlobalInvocationID.x;
    for(uint y=0u;y<8u;++y){
        uvec4 c=uvec4(imageLoad(sourceImage,ivec2(x,y))*255.0+0.5);
        result.pixels[y*8u+x]=c.x|(c.y<<8u)|(c.z<<16u)|(c.w<<24u);
    }
}
