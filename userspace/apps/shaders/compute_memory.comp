#version 450
layout(local_size_x=8,local_size_y=2,local_size_z=1) in;
layout(set=0,binding=0,std430) buffer Data { uint values[]; } data;
layout(push_constant) uniform Params { uint bias; } params;
shared uint lanes[16];
void main() {
    uint lane=gl_LocalInvocationIndex;
    uint group=gl_WorkGroupID.x+gl_NumWorkGroups.x*gl_WorkGroupID.y;
    lanes[lane]=gl_GlobalInvocationID.x+100u*gl_GlobalInvocationID.y+params.bias;
    barrier();
    uint neighbor=(lane+1u)%16u;
    data.values[group*32u+lane]=lanes[neighbor];
    atomicAdd(data.values[group*32u+16u],1u);
    barrier();
    if(lane==0u) data.values[group*32u+17u]=data.values[group*32u+16u];
}
