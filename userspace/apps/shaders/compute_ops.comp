#version 450
layout(local_size_x=4,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) buffer Data { uint words[]; } result;
uint seed=11u;
uint transform(uint x) {
    uint v=0u;
    switch(x%3u) {case 0u:v=x+17u;break;case 1u:v=x*3u;break;default:v=x^85u;break;}
    for(uint i=0u;i<3u;++i)v+=i;
    return v+seed;
}
void main(){
    uint lane=gl_GlobalInvocationID.x;uint b=lane*16u;
    result.words[b]=9u;
    result.words[b+1u]=atomicExchange(result.words[b],5u);
    result.words[b+2u]=atomicCompSwap(result.words[b],5u,12u);
    result.words[b+3u]=atomicCompSwap(result.words[b],5u,20u);
    result.words[b+4u]=atomicMin(result.words[b],7u);
    result.words[b+5u]=atomicMax(result.words[b],15u);
    result.words[b+6u]=atomicAnd(result.words[b],6u);
    result.words[b+7u]=atomicOr(result.words[b],8u);
    result.words[b+8u]=atomicXor(result.words[b],3u);
    result.words[b+9u]=atomicAdd(result.words[b],2u);
    result.words[b+10u]=transform(lane);
    result.words[b+11u]=result.words.length();
}
