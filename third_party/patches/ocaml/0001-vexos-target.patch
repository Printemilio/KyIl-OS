           /* ignored */ NULL, 0)
 
+#  elif defined(__vexos__)
+/* The native Vex futex (VEX_SYS_FUTEX), keyed by address space. */
+#    include <vex/futex.h>
+#    define CAML_PLAT_FUTEX_WAIT(ftx, undesired)            \
+  vex_futex_wait((volatile uint32_t *)(ftx), (undesired), \
+                 /* no timeout */ 0)
+#    define CAML_PLAT_FUTEX_WAKE(ftx)           \
+  vex_futex_wake((volatile uint32_t *)(ftx), INT_MAX)
+
