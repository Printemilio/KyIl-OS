diff --git a/crt/crt1.c b/crt/crt1.c
index 8fe8ab5..78e7e4f 100644
--- a/crt/crt1.c
+++ b/crt/crt1.c
@@ -5,6 +5,21 @@
 
 #include "crt_arch.h"
 
+/* Vex: the loader recognises a program built for the native Vex ABI by this
+ * ELF note rather than by its path; any other ELF is a foreign (Linux)
+ * program. The layout matches userspace/libvex/src/crt0.c. */
+__asm__(
+".section .note.vexos,\"a\",@note\n"
+".balign 4\n"
+".long 6\n"           /* namesz: "VEXOS" and its NUL */
+".long 4\n"           /* descsz */
+".long 1\n"           /* type: native ABI */
+".asciz \"VEXOS\"\n"
+".balign 4\n"
+".long 0x5645584e\n"
+".text\n"
+);
+
 int main();
 weak void _init();
 weak void _fini();
